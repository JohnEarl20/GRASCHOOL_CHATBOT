# Copy this file to `.env` and set your deployment's staff credentials.
#
#   cp .env.example .env
#
# The dashboard stays locked until STAFF_PASSCODE is set. There is no default
# passcode on purpose: a default would sit in the source and in every clone.
#
# Staff account provisioning is available only to existing staff IDs listed in
# STAFF_ADMIN_IDS. Use a comma-separated allowlist; never grant it to every
# staff account by default.
#
# On Streamlit Community Cloud, configure these in the app's Secrets panel:
#   STAFF_PASSCODE = "your-passcode-here"
#   STAFF_ADMIN_IDS = ["administrator-staff-id"]
STAFF_PASSCODE=
STAFF_ADMIN_IDS=

# Optional first-run administrator bootstrap for a deployment with no users.json.
# Set both ID and password; keep this password private and change it after setup.
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=GRA SCHOOL Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DEPARTMENT=Administration
