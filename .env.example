# Copy this file to `.env` and fill in a passcode.
#
#   cp .env.example .env
#
# The dashboard stays locked until STAFF_PASSCODE is set. There is no default
# passcode on purpose: a default would sit in the source and in every clone.
#
# On Streamlit Community Cloud, set this in the app's Secrets panel instead:
#
#   STAFF_PASSCODE = "your-passcode-here"
STAFF_PASSCODE=
