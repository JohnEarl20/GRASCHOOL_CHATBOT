# --- secrets -------------------------------------------------------------
# The staff passcode. Never commit it. code/staff_gate.py reads it from the
# environment, from .env, or from .streamlit/secrets.toml - and stays locked
# when none of them is set, so nothing secret is needed in the repository.
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# --- staff-authored content and student-facing files ---------------------
data/knowledge_articles.json
data/staff_announcements.json
data/staff_documents.json
data/staff_documents/
data/staff_reports/
data/users.json
data/chat_log.jsonl
data/harvested_chat_queries.csv
data/staff_labeled_queries.csv
data/conversations/
data/backups/
data/staff_presence.json
data/app_prefs.json
CSELEC6_Mirabete_Napili_Prefinal_Proposal.docx
CSELEC6_TeamName_Prefinal_Proposal_FILLED.docx

# --- editor / agent workspace artifacts ----------------------------------
# These are Code Janitor's own memory files. They are not imported by any
# Python module, and their previews print STAFF_PASSCODE in plaintext.
workspace.json
workspacememory.md
graphify-out/

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- stray Windows artifact ----------------------------------------------
# A 0-byte file left by a shell redirect to the reserved device name NUL.
nul

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
